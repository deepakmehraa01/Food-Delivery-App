{
  "info": {
    "name": "Product Service - catalog and inventory",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run sequentially against the public Product Service API. IDs are stored automatically. Concurrent reservations: use scripts/concurrent-reservation.ps1 with a fresh one-unit product (see docs/API.md)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "productId",
      "value": "1001"
    },
    {
      "key": "releaseOrderId",
      "value": "5001"
    },
    {
      "key": "confirmOrderId",
      "value": "5002"
    },
    {
      "key": "failedOrderId",
      "value": "5003"
    }
  ],
  "item": [
    {
      "name": "01 Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "description": "Creates product and inventory total=100, reserved=0. Saves productId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"MOBILE-{{$timestamp}}\",\n  \"name\": \"Samsung Galaxy S25\",\n  \"description\": \"5G Smartphone\",\n  \"price\": 74999,\n  \"initialQuantity\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [
        {
          "name": "201 example",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Creates product and inventory total=100, reserved=0. Saves productId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"MOBILE-{{$timestamp}}\",\n  \"name\": \"Samsung Galaxy S25\",\n  \"description\": \"5G Smartphone\",\n  \"price\": 74999,\n  \"initialQuantity\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"id\": 1001,\n  \"sku\": \"MOBILE-001\",\n  \"name\": \"Samsung Galaxy S25\",\n  \"description\": \"5G Smartphone\",\n  \"price\": 74999,\n  \"status\": \"ACTIVE\",\n  \"createdAt\": \"2026-01-01T00:00:00\",\n  \"updatedAt\": \"2026-01-01T00:00:00\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"productId\", pm.response.json().id);",
              "pm.collectionVariables.set(\"releaseOrderId\", Date.now());",
              "pm.collectionVariables.set(\"confirmOrderId\", Date.now() + 1);",
              "pm.collectionVariables.set(\"failedOrderId\", Date.now() + 2);"
            ]
          }
        }
      ]
    },
